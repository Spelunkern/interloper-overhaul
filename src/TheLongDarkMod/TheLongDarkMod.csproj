<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <DebugType>portable</DebugType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)/net6/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)/net6/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Add individual generated game references when implementing gameplay features.
         Avoid a wildcard: generated attribute types can conflict with .NET attributes. -->
    <Reference Include="Il2CppInterop.Runtime" Condition="Exists('$(MelonLoaderDir)/net6/Il2CppInterop.Runtime.dll')">
      <HintPath>$(MelonLoaderDir)/net6/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckLoader" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MelonLoaderDir)/net6/MelonLoader.dll')" Text="Install MelonLoader 0.7.3 or set TLD_GAME_DIR / -p:GameDir to the game folder." />
  </Target>
</Project>
