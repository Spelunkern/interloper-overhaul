<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Generated IL2CPP attributes conflict with nullable metadata emission. -->
    <Nullable>disable</Nullable>
    <Version>0.20.0</Version>
    <DebugType>portable</DebugType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)/net6/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)/net6/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MelonLoaderDir)/Il2CppAssemblies/Assembly-CSharp.dll</HintPath>
      <Aliases>GameAssembly</Aliases>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule;UnityEngine.PhysicsModule;Il2Cppmscorlib;Il2CppAK.Wwise.Unity.API.WwiseTypes;Il2CppTLD.IntBackedUnit;Il2CppTLD.GameplayTag;Il2CppTLD.SaveState;Il2CppTLD.PDID;Unity.Addressables">
      <HintPath>$(MelonLoaderDir)/Il2CppAssemblies/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime" Condition="Exists('$(MelonLoaderDir)/net6/Il2CppInterop.Runtime.dll')">
      <HintPath>$(MelonLoaderDir)/net6/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../shared/SaltMassRecord.cs" Link="SaltMassRecord.cs" />
    <Compile Include="../../shared/ExplorationPolicy.cs" Link="ExplorationPolicy.cs" />
    <Compile Include="../../shared/StreetLootPolicy.cs" Link="StreetLootPolicy.cs" />
    <Compile Include="../../shared/MementoRewardPolicy.cs" Link="MementoRewardPolicy.cs" />
    <Compile Include="../../shared/FoodPreparationPolicy.cs" Link="FoodPreparationPolicy.cs" />
    <Compile Include="../../shared/FireBalancePolicy.cs" Link="FireBalancePolicy.cs" />
    <Compile Include="../../shared/ClothingNutritionPolicy.cs" Link="ClothingNutritionPolicy.cs" />
    <Compile Include="../../shared/PermanentAccessoryPolicy.cs" Link="PermanentAccessoryPolicy.cs" />
    <Compile Include="../../shared/ItemBalancePolicy.cs" Link="ItemBalancePolicy.cs" />
    <Compile Include="../../shared/LightSpawnPolicy.cs" Link="LightSpawnPolicy.cs" />
    <Compile Include="../../shared/VariantPolicy.cs" Link="VariantPolicy.cs" />
    <Compile Include="../../shared/WorkshopRunState.cs" Link="WorkshopRunState.cs" />
    <Compile Include="../../shared/ManufacturingPolicy.cs" Link="ManufacturingPolicy.cs" />
    <Compile Include="../../shared/WorldPolicy.cs" Link="WorldPolicy.cs" />
    <Compile Include="../../shared/LootBalancePolicy.cs" Link="LootBalancePolicy.cs" />
    <Compile Include="../../shared/FirearmSpawnPolicy.cs" Link="FirearmSpawnPolicy.cs" />
    <Compile Include="../../shared/FirearmRunState.cs" Link="FirearmRunState.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(RuntimeValidation)' == 'true'">
    <DefineConstants>$(DefineConstants);IO_VALIDATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeValidation)' == 'true'">
    <Compile Include="../../tests/VehicleStreetValidation.cs" Link="VehicleStreetValidation.cs" />
    <Compile Include="../../tests/AfflictionValidation.cs" Link="AfflictionValidation.cs" />
    <Compile Include="../../tests/SurvivalBalanceValidation.cs" Link="SurvivalBalanceValidation.cs" />
    <Compile Include="../../tests/CookingPreparationValidation.cs" Link="CookingPreparationValidation.cs" />
    <Compile Include="../../tests/FireFeatMendingValidation.cs" Link="FireFeatMendingValidation.cs" />
    <Compile Include="../../tests/ClothingNutritionValidation.cs" Link="ClothingNutritionValidation.cs" />
    <Compile Include="../../tests/PermanentAccessoryValidation.cs" Link="PermanentAccessoryValidation.cs" />
    <Compile Include="../../tests/ItemBalanceValidation.cs" Link="ItemBalanceValidation.cs" />
    <Compile Include="../../tests/WorkshopValidation.cs" Link="WorkshopValidation.cs" />
    <Compile Include="../../tests/ManufacturingValidation.cs" Link="ManufacturingValidation.cs" />
    <Compile Include="../../tests/RuntimeValidation.cs" Link="RuntimeValidation.cs" />
    <Compile Include="../../tests/BeachcombingValidation.cs" Link="BeachcombingValidation.cs" />
    <Compile Include="../../tests/LootBalanceValidation.cs" Link="LootBalanceValidation.cs" />
    <Compile Include="../../tests/FiniteFirearmValidation.cs" Link="FiniteFirearmValidation.cs" />
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(MelonLoaderDir)/Il2CppAssemblies/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckLoader" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MelonLoaderDir)/net6/MelonLoader.dll')" Text="Install MelonLoader 0.7.3 or set TLD_GAME_DIR / -p:GameDir to the game folder." />
    <Error Condition="!Exists('$(MelonLoaderDir)/Il2CppAssemblies/Assembly-CSharp.dll')" Text="Launch the game with MelonLoader once to generate game references." />
  </Target>
</Project>
